# ShrinkToken Pro Environment Configuration
# Copy this file to .env and fill in your values

# LLMLingua Model Configuration
STP_LLMLINGUA_MODEL_NAME=microsoft/llmlingua-2-xlm-roberta-large-meetingbank
STP_DEVICE_MAP=cpu
STP_DEFAULT_COMPRESSION_MODE=balanced

# Logging
STP_LOG_LEVEL=INFO

# API Keys (for future phases)
# STP_OPENAI_API_KEY=
# STP_ANTHROPIC_API_KEY=

# Database (for future phases)
# STP_DATABASE_URL=sqlite:///./shrinktoken.db
